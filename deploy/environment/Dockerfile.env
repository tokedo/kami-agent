# kami-agent environment image (SPEC D8): the agent's own machine under the
# shell rungs. Runs with NO network (compose: network_mode none) and holds
# no key. One image per rung: KEEPER_SHA empty = `shell` (no keeper client
# at all, so the plain rung cannot learn a keeper exists), set = `shell_keeper`.
#
#   docker build -f Dockerfile.env --build-arg LENS_SHA=<sha> \
#     -t kami-agent-env:<agent version>-shell .
#   docker build -f Dockerfile.env --build-arg LENS_SHA=<sha> --build-arg KEEPER_SHA=<sha> \
#     -t kami-agent-env:<agent version>-shell_keeper .
#
# LENS_REPO and KEEPER_REPO default to the public repositories the pins
# name; pass either only to build from a mirror.
FROM node:22-bookworm-slim
ARG LENS_REPO=https://github.com/tokedo/kami-lens
ARG LENS_SHA
ARG KEEPER_REPO=https://github.com/tokedo/kami-keeper
ARG KEEPER_SHA=
# The toolset the shell appendix names (prompts/shell.txt) — procps among
# it (ps, pgrep: a process the agent left running is something it can look
# for) — and ca-certificates for the build's own clones. No network at run
# time, so nothing is installable later: what is here is the environment.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash coreutils grep sed gawk jq git sqlite3 less nano procps ca-certificates \
      python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
# kami-lens CLI at the pin (a socket client; its daemon runs elsewhere)
RUN test -n "$LENS_SHA" \
    && git clone --filter=blob:none "$LENS_REPO" /opt/kami-lens \
    && git -C /opt/kami-lens checkout "$LENS_SHA" \
    && cd /opt/kami-lens && npm ci && npm run build && npm prune --omit=dev \
    && rm -rf /opt/kami-lens/.git \
    && printf '#!/bin/sh\nexec node /opt/kami-lens/dist/cli.js "$@"\n' > /usr/local/bin/kami-lens \
    && chmod 755 /usr/local/bin/kami-lens
# keeper CLIENT at the pin, without the daemon's dependencies (shell_keeper
# only). The client's import graph is the standard library (its cli,
# protocol, profiles, scrub and server modules), so the package directory
# is copied as it is and the `keeper` command is a two-line wrapper over
# `python -m keeper` — the same entry point a console script would call.
# The copy form serves kami-keeper 1.0.0 (no build-system, no console
# script) and 1.0.1 (both) alike, and needs no pip at build time.
# `keeper daemon` cannot run here: its dependencies are not installed.
RUN if [ -n "$KEEPER_SHA" ]; then \
      git clone --filter=blob:none "$KEEPER_REPO" /opt/kami-keeper-src \
      && git -C /opt/kami-keeper-src checkout "$KEEPER_SHA" \
      && mkdir -p /opt/kami-keeper /srv/keeper \
      && cp -r /opt/kami-keeper-src/keeper /opt/kami-keeper/keeper \
      && rm -rf /opt/kami-keeper-src /opt/kami-keeper/keeper/__pycache__ \
      && python3 -m compileall -q /opt/kami-keeper \
      && printf '#!/bin/sh\nexec env PYTHONPATH=/opt/kami-keeper python3 -m keeper "$@"\n' > /usr/local/bin/keeper \
      && chmod 755 /usr/local/bin/keeper \
      && keeper --help >/dev/null; \
    else ! command -v keeper >/dev/null; fi
# uid 1000 is the node image's own `node` user; the environment's user is
# created in its place so the uid the scaffold names (SPEC D8) is `agent`.
RUN (userdel node 2>/dev/null || true) && (groupdel node 2>/dev/null || true) \
    && groupadd --gid 1000 agent \
    && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /workspace --shell /bin/bash agent \
    && mkdir -p /workspace /reference /journal /srv/lens \
    && chown 1000:1000 /workspace
ENV KAMI_LENS_DATA_DIR=/srv/lens HOME=/workspace
USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
