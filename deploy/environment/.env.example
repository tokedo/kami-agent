# Variables for deploy/environment (copy to .env beside the compose files).
# Every ${VAR} the compose files and Dockerfile.env read is named here.

# The kami-agent version: the agent image tag and the env image tag's prefix.
AGENT_VERSION=0.8.0
# The rung the env image was built for: shell or shell_keeper.
RUNG=shell
# kami-lens commit: the lens image tag (kami-lens:<sha>) and the env image's
# kami-lens CLI (Dockerfile.env build arg).
LENS_SHA=
# kami-keeper commit, shell_keeper only: the keeper image tag
# (kami-keeper:<sha>) and the env image's keeper client. Must equal the
# manifest's pins.keeper_sha — `kami-agent init` refuses a mismatch.
KEEPER_SHA=
# The agent service's poll cadence in seconds (SPEC D4).
POLL_SECONDS=300

# Build arguments of Dockerfile.env (docker build --build-arg), named here
# so every variable of the definition is in one place: the git URLs the
# image's kami-lens and keeper clients are cloned from.
LENS_REPO=
KEEPER_REPO=
