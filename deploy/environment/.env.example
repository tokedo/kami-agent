# Variables for deploy/environment (copy to .env beside the compose files).
# Every ${VAR} the compose files and Dockerfile.env read is named here.

# The kami-agent version: the agent image tag and the env image tag's prefix.
AGENT_VERSION=0.8.0
# The rung the env image was built for: shell or shell_keeper.
RUNG=shell
# kami-lens commit: the lens image tag (kami-lens:<sha>) and the env image's
# kami-lens CLI (Dockerfile.env build arg).
LENS_SHA=
# kami-keeper commit, shell_keeper only: the keeper image tag
# (kami-keeper:<sha>) and the env image's keeper client. Must equal the
# manifest's pins.keeper_sha — `kami-agent init` refuses a mismatch.
KEEPER_SHA=
# The chain the keeper signs on, shell_keeper only. The keeper runs armed,
# and armed it starts its engine only once all of RPC URL, world address and
# chain id are set — without them the daemon answers `status` and runs
# nothing. Public Yominet constants, the defaults kami-lens 1.1.0 ships
# (its src/config.ts); change them only to point the keeper at another
# endpoint of the same chain.
KEEPER_RPC_URL=https://jsonrpc-yominet-1.anvil.asia-southeast.initia.xyz
KEEPER_WS_RPC_URL=wss://jsonrpc-ws-yominet-1.anvil.asia-southeast.initia.xyz
KEEPER_WORLD_ADDRESS=0x2729174c265dbBd8416C6449E0E813E88f43D0E7
KEEPER_CHAIN_ID=428962654539583
# The agent service's poll cadence in seconds (SPEC D4).
POLL_SECONDS=300

# Optional build-argument overrides of Dockerfile.env (docker build
# --build-arg), named here so every variable of the definition is in one
# place: the git URLs the image's kami-lens and keeper clients are cloned
# from. Unset, they are the public repositories (Dockerfile.env's defaults);
# set one only to build from a mirror — an empty value would override the
# default with nothing.
# LENS_REPO=https://github.com/tokedo/kami-lens
# KEEPER_REPO=https://github.com/tokedo/kami-keeper
